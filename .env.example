DATABASE_URL=postgresql+asyncpg://aurum:change-me@localhost:5432/aurum_pos
APP_NAME="Aurum POS"
ENV=local
DEPLOYMENT_MODE=self_hosted

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=aurum-pos
JWT_AUDIENCE=aurum-pos-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_PER_IP=30
AUTH_RATE_LIMIT_PER_ACCOUNT=10

# JSON array of origins allowed by the backend.
CORS_ORIGINS=["http://localhost:5174","http://localhost:4173","https://localhost","capacitor://localhost","https://aurumpos.net"]

FREE_ACTIVE_ITEM_LIMIT=50
SOURCE_REPOSITORY_URL=https://github.com/duelistraj/aurum-pos
GOOGLE_WEB_CLIENT_ID=
GOOGLE_PLAY_PACKAGE_NAME=com.duelistraj.aurumpos
GOOGLE_PLAY_PRODUCT_ID=aurum_cloud_pro
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
BILLING_TOKEN_ENCRYPTION_KEY=

EMAIL_FROM="Aurum POS <noreply@aurumpos.net>"
SES_REGION=ap-southeast-1

AWS_REGION=ap-southeast-1
S3_INVOICE_BUCKET=replace-with-private-invoice-bucket
S3_INVOICE_PREFIX=shops
S3_PRESIGNED_URL_EXPIRY_SECONDS=600

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=15
WORKER_EMAIL_MAX_ATTEMPTS=8
WORKER_EMAIL_CONCURRENCY=5
WORKER_RECONCILIATION_BATCH_SIZE=100
WORKER_RECONCILIATION_CONCURRENCY=5

PUBLIC_SITE_URL=https://aurumpos.net
