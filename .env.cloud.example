DATABASE_URL=postgresql+asyncpg://aurum:replace-me@aiven-host:24900/defaultdb?ssl=require
APP_NAME="Aurum POS"
ENV=production
DEPLOYMENT_MODE=hosted

JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=aurum-pos
JWT_AUDIENCE=aurum-pos-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# JSON array of origins allowed by the backend.
CORS_ORIGINS=["https://localhost","capacitor://localhost","https://aurumpos.net"]

FREE_ACTIVE_ITEM_LIMIT=50
SOURCE_REPOSITORY_URL=https://github.com/duelistraj/aurum-pos
GOOGLE_WEB_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_PLAY_PACKAGE_NAME=com.duelistraj.aurumpos
GOOGLE_PLAY_PRODUCT_ID=aurum_cloud_pro
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"replace-me"}'
GOOGLE_PLAY_PUBSUB_AUDIENCE=https://api.aurumpos.net/api/v1/billing/google-play/rtdn
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=play-rtdn@replace-me.iam.gserviceaccount.com
BILLING_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

EMAIL_FROM="Aurum POS <noreply@aurumpos.net>"
SES_REGION=ap-south-1
PUBLIC_SITE_URL=https://aurumpos.net

# Used by backup tooling, not passed to application containers.
DIRECT_DATABASE_URL=postgresql://aurum:replace-me@aiven-host:24900/defaultdb?sslmode=require
BACKUP_S3_BUCKET=replace-with-versioned-backup-bucket
